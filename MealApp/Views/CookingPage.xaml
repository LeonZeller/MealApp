<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MealApp.Views.CookingPage"
             Title="Kochen">
    <Grid RowDefinitions="Auto, *, Auto" Padding="20">
        <VerticalStackLayout Grid.Row="0" Spacing="5" Margin="0,20,0,30">
            <Label Text="{Binding MealName}"
                   FontSize="18"
                   TextColor="Gray"
                   HorizontalOptions="Center"/>
            <Label Text="{Binding StepProgress}"
                   FontSize="14"
                   TextColor="Gray"
                   HorizontalOptions="Center"/>
            <ProgressBar Progress="{Binding ProgressValue}"
                         HeightRequest="6"
                         Margin="0,10,0,0"/>
        </VerticalStackLayout>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="20" VerticalOptions="Center">
                <Label Text="{Binding CurrentStepNumber, StringFormat='Schritt {0}'}"
                       FontSize="48"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"/>
                <Label Text="{Binding CurrentStepText}"
                       FontSize="20"
                       HorizontalTextAlignment="Center"
                       LineHeight="1.5"/>
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="2" ColumnDefinitions="*, *" ColumnSpacing="10">
            <Button Grid.Column="0"
                    Text="Zurück"
                    Clicked="OnPreviousClicked"
                    IsEnabled="{Binding CanGoPrevious}"/>
            <Button Grid.Column="1"
                    Text="{Binding NextButtonText}"
                    Clicked="OnNextClicked"/>
        </Grid>
    </Grid>
</ContentPage>