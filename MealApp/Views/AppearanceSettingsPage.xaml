<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MealApp.Views.AppearanceSettingsPage"
             Title="Erscheinungsbild">

    <VerticalStackLayout Padding="20" Spacing="20">

        <Label Text="App-Theme" FontAttributes="Bold" FontSize="16"/>

        <RadioButton x:Name="SystemRadio"
                     Content="System"
                     GroupName="Theme"
                     CheckedChanged="OnThemeChanged"/>
        <RadioButton x:Name="LightRadio"
                     Content="Hell"
                     GroupName="Theme"
                     CheckedChanged="OnThemeChanged"/>
        <RadioButton x:Name="DarkRadio"
                     Content="Dunkel"
                     GroupName="Theme"
                     CheckedChanged="OnThemeChanged"/>

    </VerticalStackLayout>

</ContentPage>