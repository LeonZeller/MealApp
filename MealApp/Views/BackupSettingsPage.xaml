<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MealApp.Views.BackupSettingsPage"
             Title="Datenexport &amp; Backup">

    <VerticalStackLayout Padding="20" Spacing="20">

        <Label Text="Exportiere deine Daten als Backup-Datei oder importiere ein vorhandenes Backup."
               TextColor="Gray"
               FontSize="13"/>

        <Button Text="Backup exportieren"
                Clicked="OnExportClicked"/>

        <Button Text="Backup importieren"
                Clicked="OnImportClicked"/>

    </VerticalStackLayout>

</ContentPage>