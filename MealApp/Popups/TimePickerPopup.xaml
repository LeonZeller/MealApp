<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:wp="https://vapolia.eu/WheelPicker"
             x:Class="MealApp.Popups.TimePickerPopup"
             BackgroundColor="#80000000">

    <Grid VerticalOptions="Center" HorizontalOptions="Center">
        <Frame BackgroundColor="White"
               CornerRadius="15"
               Padding="20"
               WidthRequest="300">
            <VerticalStackLayout Spacing="20">

                <Label Text="Uhrzeit auswählen"
                       FontSize="18"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"/>

                <wp:WheelPicker x:Name="TimeWheelPicker"
                                HeightRequest="180"
                                ItemsSource="{Binding WheelItems}"
                                SelectedItemIndexChanged="OnSelectionChanged">
                    <wp:WheelDefinition Width="*" HorizontalOptions="Center" Alignment="Center"/>
                    <wp:WheelDefinition Width="*" HorizontalOptions="Center" Alignment="Center"/>
                </wp:WheelPicker>

                <HorizontalStackLayout HorizontalOptions="Center" Spacing="15" Margin="0,10,0,0">
                    <Label Text="Personen:" VerticalOptions="Center" FontAttributes="Bold"/>
                    <Button Text="-" Clicked="OnPersonsMinusClicked" WidthRequest="40" HeightRequest="40"/>
                    <Label x:Name="PersonsLabel" Text="1"
                           FontSize="20" VerticalOptions="Center"
                           WidthRequest="30" HorizontalTextAlignment="Center"/>
                    <Button Text="+" Clicked="OnPersonsPlusClicked"
                            WidthRequest="40" HeightRequest="40"/>
                </HorizontalStackLayout>

                <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
                    <Button Text="Abbrechen"
                            Clicked="OnCancelClicked"
                            BackgroundColor="LightGray"
                            TextColor="Black"
                            WidthRequest="120"/>
                    <Button Text="OK"
                            Clicked="OnOkClicked"
                            WidthRequest="120"/>
                </HorizontalStackLayout>

            </VerticalStackLayout>
        </Frame>
    </Grid>

</ContentPage>