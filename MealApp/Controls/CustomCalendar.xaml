<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MealApp.Controls.CustomCalendar">

    <VerticalStackLayout Spacing="10">

        <!-- Header mit Monat und Navigation -->
        <Grid ColumnDefinitions="Auto, *, Auto" Padding="10,0">
            <Button Grid.Column="0"
                    Text="◀"
                    BackgroundColor="Transparent"
                    TextColor="{AppThemeBinding Light=Black, Dark=White}"
                    Clicked="OnPreviousMonthClicked"/>
            <Label Grid.Column="1"
                   x:Name="MonthLabel"
                   FontSize="18"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"/>
            <Button Grid.Column="2"
                    Text="▶"
                    BackgroundColor="Transparent"
                    TextColor="{AppThemeBinding Light=Black, Dark=White}"
                    Clicked="OnNextMonthClicked"/>
        </Grid>

        <!-- Wochentage Header -->
        <Grid x:Name="WeekdayHeader"
              ColumnDefinitions="*,*,*,*,*,*,*"
              Padding="5"/>

        <!-- Tage Grid -->
        <Grid x:Name="DaysGrid"
              ColumnDefinitions="*,*,*,*,*,*,*"
              RowDefinitions="*,*,*,*,*,*"
              Padding="5"
              RowSpacing="4"
              ColumnSpacing="4"/>

    </VerticalStackLayout>

</ContentView>